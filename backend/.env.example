# API and security
APP_NAME=Question Paper Studio API
SECRET_KEY=replace-with-a-private-random-secret-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=question_paper_studio
CORS_ORIGINS=http://localhost:5173

# Online generation provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Provider selection: auto, gemini, or ollama
LLM_PROVIDER_MODE=auto
